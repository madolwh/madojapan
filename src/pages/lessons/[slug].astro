---
import { getCollection, getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const lessons = await getCollection(
    'lessons',
    // Drafts are visible while writing, excluded from the production build.
    ({ data }) => import.meta.env.DEV || !data.draft,
  );

  return lessons.map((lesson) => ({
    params: { slug: lesson.data.slug },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { title, summary, category, level, videoUrl, audioUrl, vocab, publishedAt } =
  lesson.data;
const { Content } = await render(lesson);

// reference() validates shape but not existence — a typo'd slug resolves to
// null and would silently render a gap. Fail the build instead.
const entries = await getEntries(vocab);
const missing = vocab.filter((_, i) => !entries[i]).map((ref) => ref.id);
if (missing.length > 0) {
  throw new Error(
    `Lesson "${lesson.id}" references vocab that does not exist: ${missing.join(', ')}. ` +
      `Add src/content/vocab/${missing[0]}.md or fix the slug.`,
  );
}
---

<BaseLayout title={title} description={summary} type="article" publishedAt={publishedAt}>
  <div class="mx-auto max-w-2xl px-5">
    {/* Only elements inside data-pagefind-body get indexed, which keeps the
        header, footer and nav out of every search result. */}
    <article data-pagefind-body>
      <span data-pagefind-meta={`category:${category}`} hidden></span>
      <span data-pagefind-meta={`level:${level}`} hidden></span>
      <div class="flex gap-2">
        <span class="bg-tag px-2 py-1 text-xs tracking-wide">{category}</span>
        <span class="border border-rule px-2 py-1 text-xs tracking-wide text-muted">{level}</span>
      </div>

      <h1 class="display mt-5 text-3xl">{title}</h1>
      <p class="mt-4 text-sm leading-relaxed text-muted">{summary}</p>

      {
        audioUrl && (
          <audio controls preload="none" src={audioUrl} class="mt-6 w-full">
            Your browser does not support the audio element.
          </audio>
        )
      }

      <div class="lesson-body mt-7 border-t border-rule pt-6 leading-relaxed">
        <Content />
      </div>

      <section class="mt-12" aria-labelledby="vocab-heading">
        <h2 id="vocab-heading" class="sr-only">Vocab</h2>
        <dl class="space-y-12">
          {
            entries.map((entry) => (
              <div>
                <dt class="text-center">
                  {/* Furigana as semantic ruby. The marker sits on the base
                      only, so it does not wash over the reading above. */}
                  <ruby lang="ja" class="text-6xl leading-tight">
                    <span class="bg-marker px-3">{entry.data.term}</span>
                    <rp>(</rp>
                    <rt class="text-xs text-muted">{entry.data.reading}</rt>
                    <rp>)</rp>
                  </ruby>
                  <p class="mt-3 text-xs tracking-widest text-muted uppercase">
                    {entry.data.romaji}
                  </p>
                </dt>
                <dd class="mt-5">
                  <p class="text-base">{entry.data.meaning}</p>
                  <p class="mt-1 text-xs tracking-wide text-muted">{entry.data.register}</p>

                  {entry.data.singlishEquivalent && (
                    <div class="mt-4 border-l-2 border-tag pl-3">
                      <p class="text-xs font-bold tracking-wide text-ink uppercase">In Singlish</p>
                      <p class="mt-1 text-sm leading-relaxed">{entry.data.singlishEquivalent}</p>
                    </div>
                  )}

                  {entry.data.chineseNote && (
                    <div class="mt-4 border-l-2 border-alert pl-3">
                      <p class="text-xs font-bold tracking-wide text-alert uppercase">In Chinese</p>
                      <p class="mt-1 text-sm leading-relaxed">{entry.data.chineseNote}</p>
                    </div>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      {
        /* Hard rule 1: linked, never embedded. */
        videoUrl && (
          <p class="mt-12 border-t border-rule pt-6">
            <a
              href={videoUrl}
              rel="noopener noreferrer"
              target="_blank"
              class="border-b border-alert pb-0.5 text-sm text-alert"
            >
              Watch the video
            </a>
          </p>
        )
      }
    </article>
  </div>
</BaseLayout>
