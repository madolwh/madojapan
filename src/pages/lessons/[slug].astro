---
import { getCollection, getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const lessons = await getCollection(
    'lessons',
    // Drafts are visible while writing, excluded from the production build.
    ({ data }) => import.meta.env.DEV || !data.draft,
  );

  return lessons.map((lesson) => ({
    params: { slug: lesson.data.slug },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { title, summary, category, level, videoUrl, audioUrl, vocab, publishedAt } =
  lesson.data;
const { Content } = await render(lesson);

// reference() validates shape but not existence — a typo'd slug resolves to
// null and would silently render a gap. Fail the build instead.
const entries = await getEntries(vocab);
const missing = vocab.filter((_, i) => !entries[i]).map((ref) => ref.id);
if (missing.length > 0) {
  throw new Error(
    `Lesson "${lesson.id}" references vocab that does not exist: ${missing.join(', ')}. ` +
      `Add src/content/vocab/${missing[0]}.md or fix the slug.`,
  );
}
---

<BaseLayout title={title} description={summary} type="article" publishedAt={publishedAt}>
  <div class="wrap">
    {/* Only elements inside data-pagefind-body get indexed, which keeps the
        header, footer and nav out of every search result. */}
    <article data-pagefind-body>
      <span data-pagefind-meta={`category:${category}`} hidden></span>
      <span data-pagefind-meta={`level:${level}`} hidden></span>

      <h1 class="display-xl mt-8">{title}</h1>

      <div class="mt-12 grid gap-10 border-t border-rule pt-8 md:grid-cols-[14rem_1fr] md:gap-16">
        <aside class="flex flex-col gap-5 md:sticky md:top-8 md:self-start">
          <div class="flex flex-wrap gap-2">
            <span class="bg-tag px-2 py-0.5 text-xs">{category}</span>
            <span class="border border-rule px-2 py-0.5 text-xs text-muted">{level}</span>
          </div>

          {
            audioUrl && (
              <audio controls preload="none" src={audioUrl} class="w-full">
                Your browser does not support the audio element.
              </audio>
            )
          }

          {
            /* Hard rule 1: linked, never embedded. */
            videoUrl && (
              <a
                href={videoUrl}
                rel="noopener noreferrer"
                target="_blank"
                class="self-start border-b border-alert pb-0.5 text-sm text-alert">
                Watch the video
              </a>
            )
          }
        </aside>

        <div>
          <p class="measure text-lg leading-relaxed text-muted">{summary}</p>
          <div class="lesson-body measure mt-8 text-lg leading-relaxed">
            <Content />
          </div>
        </div>
      </div>

      <section class="mt-24 border-t border-rule" aria-labelledby="vocab-heading">
        <h2 id="vocab-heading" class="sr-only">Vocab</h2>
        <dl>
          {
            entries.map((entry) => (
              <div class="grid gap-8 border-b border-rule py-16 md:grid-cols-[1fr_1fr] md:items-center md:gap-16">
                <dt class="text-center md:text-left">
                  {/* Furigana as semantic ruby. The marker sits on the base
                      only, so it does not wash over the reading above. */}
                  {/* Longer terms step down a size. Without this a four
                      character phrase renders four times the width of a
                      single kanji and the meaning column starts somewhere
                      different on every row. */}
                  <ruby
                    lang="ja"
                    class="leading-none"
                    style={`font-size: ${
                      entry.data.term.length >= 4
                        ? 'clamp(2.75rem,8vw,5.5rem)'
                        : entry.data.term.length === 3
                          ? 'clamp(3.25rem,10vw,7rem)'
                          : 'clamp(4rem,14vw,11rem)'
                    }`}>
                    {/* inline-block, not inline: an inline background is sized
                        by the font's em box, so kana with descenders (び, れ)
                        spill out below the marker. */}
                    <span class="bg-marker inline-block px-4 pt-2 pb-3 leading-none">
                      {entry.data.term}
                    </span>
                    <rp>(</rp>
                    <rt class="text-sm text-muted">{entry.data.reading}</rt>
                    <rp>)</rp>
                  </ruby>
                  <p class="mt-6 text-xs tracking-widest text-muted uppercase">
                    {entry.data.romaji}
                  </p>
                </dt>

                <dd class="measure">
                  <p class="text-2xl leading-snug">{entry.data.meaning}</p>
                  <p class="mt-2 text-xs tracking-wide text-muted">{entry.data.register}</p>

                  {entry.data.singlishEquivalent && (
                    <div class="mt-6 border-l-2 border-tag pl-4">
                      <p class="text-xs font-bold tracking-wide text-ink uppercase">In Singlish</p>
                      <p class="mt-1 leading-relaxed">{entry.data.singlishEquivalent}</p>
                    </div>
                  )}

                  {entry.data.chineseNote && (
                    <div class="mt-6 border-l-2 border-alert pl-4">
                      <p class="text-xs font-bold tracking-wide text-alert uppercase">In Chinese</p>
                      <p class="mt-1 leading-relaxed">{entry.data.chineseNote}</p>
                    </div>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
    </article>

    <p class="mt-12">
      <a href="/lessons" class="border-b border-alert pb-0.5 text-sm text-alert">All lessons</a>
    </p>
  </div>
</BaseLayout>
