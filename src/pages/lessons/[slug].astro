---
import { getCollection, getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const lessons = await getCollection(
    'lessons',
    // Drafts are visible while writing, excluded from the production build.
    ({ data }) => import.meta.env.DEV || !data.draft,
  );

  return lessons.map((lesson) => ({
    params: { slug: lesson.data.slug },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { title, summary, category, level, videoUrl, audioUrl, vocab, publishedAt } =
  lesson.data;
const { Content } = await render(lesson);

// Anything this long is a sentence, not a word, and gets a different layout:
// wrapping, no furigana, and set at reading size rather than display size.
const isPhrase = (term: string) => term.length >= 8;

// Display size steps down as terms get longer. Without this a five-kana word
// renders several times the width of a single kanji, and wraps inside its own
// marker once it exceeds the column.
const termSize = (term: string) =>
  term.length >= 5
    ? 'clamp(2rem,6vw,4rem)'
    : term.length === 4
      ? 'clamp(2.75rem,8vw,5.5rem)'
      : term.length === 3
        ? 'clamp(3.25rem,10vw,7rem)'
        : 'clamp(4rem,14vw,11rem)';

// reference() validates shape but not existence — a typo'd slug resolves to
// null and would silently render a gap. Fail the build instead.
const entries = await getEntries(vocab);
const missing = vocab.filter((_, i) => !entries[i]).map((ref) => ref.id);
if (missing.length > 0) {
  throw new Error(
    `Lesson "${lesson.id}" references vocab that does not exist: ${missing.join(', ')}. ` +
      `Add src/content/vocab/${missing[0]}.md or fix the slug.`,
  );
}
---

<BaseLayout title={title} description={summary} type="article" publishedAt={publishedAt}>
  <div class="wrap">
    {/* Only elements inside data-pagefind-body get indexed, which keeps the
        header, footer and nav out of every search result. */}
    <article data-pagefind-body>
      <span data-pagefind-meta={`category:${category}`} hidden></span>
      <span data-pagefind-meta={`level:${level}`} hidden></span>

      <h1 class="display-xl mt-8">{title}</h1>

      <div class="mt-12 grid gap-10 border-t border-rule pt-8 md:grid-cols-[14rem_1fr] md:gap-16">
        <aside class="flex flex-col gap-5 md:sticky md:top-8 md:self-start">
          <div class="flex flex-wrap gap-2">
            <span class="bg-tag px-2 py-0.5 text-xs">{category}</span>
            <span class="border border-rule px-2 py-0.5 text-xs text-muted">{level}</span>
          </div>

          {
            audioUrl && (
              <audio controls preload="none" src={audioUrl} class="w-full">
                Your browser does not support the audio element.
              </audio>
            )
          }

          {
            /* Hard rule 1: linked, never embedded. */
            videoUrl && (
              <a
                href={videoUrl}
                rel="noopener noreferrer"
                target="_blank"
                class="self-start border-b border-alert pb-0.5 text-sm text-alert">
                Watch the video
              </a>
            )
          }
        </aside>

        <div>
          <p class="measure text-lg leading-relaxed text-muted">{summary}</p>
          <div class="lesson-body measure mt-8 text-lg leading-relaxed">
            <Content />
          </div>
        </div>
      </div>

      {/* An essay-style lesson can legitimately have no vocab; without this
          it would render an empty bordered section. */}
      <section
        class="mt-24 border-t border-rule"
        aria-labelledby="vocab-heading"
        hidden={entries.length === 0}>
        <h2 id="vocab-heading" class="sr-only">Vocab</h2>
        <dl>
          {
            entries.map((entry) => (
              <div
                class:list={[
                  'gap-8 border-b border-rule py-16',
                  isPhrase(entry.data.term)
                    ? 'block'
                    : 'grid md:grid-cols-[1fr_1fr] md:items-center md:gap-16',
                ]}>
                <dt class:list={[isPhrase(entry.data.term) ? '' : 'text-center md:text-left']}>
                  {
                    isPhrase(entry.data.term) ? (
                      /* A sentence gets set as a sentence: it wraps, it is not
                         set at display size, and it carries no furigana —
                         kana over a whole line is not how Japanese is
                         annotated. box-decoration-break keeps the marker tight
                         on every wrapped line. */
                      <p
                        lang="ja"
                        class="text-[clamp(1.6rem,4.4vw,2.6rem)] leading-[1.75] font-bold">
                        <span class="bg-marker box-decoration-clone px-3 py-1">
                          {entry.data.term}
                        </span>
                      </p>
                    ) : (
                      /* Longer terms step down a size. Without this a four
                         character word renders four times the width of a
                         single kanji and the meaning column starts somewhere
                         different on every row. */
                      <ruby
                        lang="ja"
                        class="leading-none whitespace-nowrap"
                        style={`font-size: ${termSize(entry.data.term)}`}>
                        {/* inline-block, not inline: an inline background is
                            sized by the font's em box, so kana with descenders
                            (び, れ) spill out below the marker. */}
                        <span class="bg-marker inline-block px-4 pt-2 pb-3 leading-none">
                          {entry.data.term}
                        </span>
                        {/* Kana-only terms read the same as their reading, so
                            the furigana would just repeat the word above. */}
                        {entry.data.reading && entry.data.reading !== entry.data.term && (
                          <>
                            <rp>(</rp>
                            <rt class="text-sm text-muted">{entry.data.reading}</rt>
                            <rp>)</rp>
                          </>
                        )}
                      </ruby>
                    )
                  }
                  <p
                    class:list={[
                      'text-xs tracking-widest text-muted uppercase',
                      isPhrase(entry.data.term) ? 'mt-4' : 'mt-6',
                    ]}>
                    {entry.data.romaji}
                  </p>
                </dt>

                <dd class:list={['measure', isPhrase(entry.data.term) && 'mt-8']}>
                  <p class="text-2xl leading-snug">{entry.data.meaning}</p>
                  <p class="mt-1 text-xs tracking-wide text-muted">{entry.data.register}</p>

                  {entry.data.description && (
                    <p class="mt-5 leading-relaxed">{entry.data.description}</p>
                  )}

                  {entry.data.singlishEquivalent && (
                    <div class="mt-6 border-l-2 border-tag pl-4">
                      <p class="text-xs font-bold tracking-wide text-ink uppercase">In Singlish</p>
                      <p class="mt-1 leading-relaxed">{entry.data.singlishEquivalent}</p>
                    </div>
                  )}

                  {entry.data.chineseNote && (
                    <div class="mt-6 border-l-2 border-alert pl-4">
                      <p class="text-xs font-bold tracking-wide text-alert uppercase">In Chinese</p>
                      <p class="mt-1 leading-relaxed">{entry.data.chineseNote}</p>
                    </div>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
    </article>

    <p class="mt-12">
      <a href="/lessons" class="border-b border-alert pb-0.5 text-sm text-alert">All lessons</a>
    </p>
  </div>
</BaseLayout>
