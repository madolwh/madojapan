---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const lessons = await getCollection(
  'lessons',
  ({ data }) => import.meta.env.DEV || !data.draft,
);

lessons.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Derived from the content, not hardcoded, so a new category can never
// appear in a lesson without also appearing as a filter.
const categories = [...new Set(lessons.map((l) => l.data.category))].sort();
const levelOrder = ['beginner', 'intermediate', 'advanced'] as const;
const levels = levelOrder.filter((lv) => lessons.some((l) => l.data.level === lv));
---

<BaseLayout
  title="Lessons"
  description="Short Japanese lessons with a Singlish and Chinese-speaker angle.">
  <div class="wrap">
    <h1 class="display-xl mt-8 mb-10">Lessons</h1>

    <div data-filters class="space-y-2 border-t border-rule pt-5">
      <div class="flex flex-wrap items-center gap-2">
        <span class="w-14 text-xs text-muted">topic</span>
        <button type="button" data-filter="category" data-value="" aria-pressed="true" class="chip">
          all
        </button>
        {
          categories.map((c) => (
            <button type="button" data-filter="category" data-value={c} aria-pressed="false" class="chip">
              {c}
            </button>
          ))
        }
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="w-14 text-xs text-muted">level</span>
        <button type="button" data-filter="level" data-value="" aria-pressed="true" class="chip">
          all
        </button>
        {
          levels.map((lv) => (
            <button type="button" data-filter="level" data-value={lv} aria-pressed="false" class="chip">
              {lv}
            </button>
          ))
        }
      </div>
    </div>

    <p data-count class="mt-6 text-xs text-muted" aria-live="polite">
      {lessons.length}{lessons.length === 1 ? ' lesson' : ' lessons'}
    </p>

    <ul class="mt-2 border-t border-rule">
      {
        lessons.map((lesson, i) => (
          <li
            data-lesson
            data-category={lesson.data.category}
            data-level={lesson.data.level}
            class="border-b border-rule">
            <a
              href={`/lessons/${lesson.data.slug}`}
              class="group grid grid-cols-1 gap-3 py-7 md:grid-cols-[4rem_1fr_18rem] md:items-baseline md:gap-8">
              <span class="text-xs text-muted tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>

              <h2 class="display-lg group-hover:text-alert">{lesson.data.title}</h2>

              <span class="flex flex-col gap-3">
                <span class="flex gap-2">
                  <span class="bg-tag px-2 py-0.5 text-xs">{lesson.data.category}</span>
                  <span class="border border-rule px-2 py-0.5 text-xs text-muted">
                    {lesson.data.level}
                  </span>
                </span>
                <span class="text-sm leading-relaxed text-muted">{lesson.data.summary}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p data-empty hidden class="mt-8 text-sm text-muted">No lessons match those filters.</p>
  </div>
</BaseLayout>

<script>
  // Progressive enhancement: every lesson is already in the HTML, so with
  // JavaScript off the full list still renders and every link still works.
  // This only hides rows.
  const root = document.querySelector<HTMLElement>('[data-filters]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-lesson]')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  if (root && items.length) {
    const active: Record<string, string> = { category: '', level: '' };

    const apply = () => {
      let shown = 0;
      for (const item of items) {
        const match =
          (!active.category || item.dataset.category === active.category) &&
          (!active.level || item.dataset.level === active.level);
        item.hidden = !match;
        if (match) shown += 1;
      }
      if (count) count.textContent = `${shown} ${shown === 1 ? 'lesson' : 'lessons'}`;
      if (empty) empty.hidden = shown !== 0;
    };

    root.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!button) return;

      const group = button.dataset.filter!;
      active[group] = button.dataset.value ?? '';

      for (const sibling of root.querySelectorAll<HTMLButtonElement>(
        `[data-filter="${group}"]`,
      )) {
        sibling.setAttribute('aria-pressed', String(sibling === button));
      }
      apply();
    });
  }
</script>
