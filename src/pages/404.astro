---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="That page does not exist.">
  <div class="wrap">
    <h1 class="display-lg mt-8">Not found</h1>
    <p class="mt-4 text-sm leading-relaxed text-muted">
      That page doesn't exist. It may have moved, or the link may be wrong.
    </p>
    <ul class="mt-8 space-y-3 text-sm">
      <li>
        <a href="/lessons" class="border-b border-alert pb-0.5 text-alert">Browse all lessons</a>
      </li>
      <li>
        <a href="/search" class="border-b border-alert pb-0.5 text-alert">Search</a>
      </li>
    </ul>
  </div>
</BaseLayout>
