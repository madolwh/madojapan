---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const lessons = await getCollection(
  'lessons',
  ({ data }) => import.meta.env.DEV || !data.draft,
);

lessons.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const latest = lessons.slice(0, 3);
---

<BaseLayout
  title="Japanese, one thing at a time"
  description="Short Japanese lessons with a Singlish and Chinese-speaker angle.">
  <div class="mx-auto max-w-2xl px-5">
    <h1 class="display text-4xl">Japanese, one thing at a time</h1>
    <p class="mt-4 text-sm leading-relaxed text-muted">
      Short lessons, written for anyone learning Japanese — with the
      comparisons a Singlish or Chinese speaker would actually notice.
    </p>

    {
      latest.length > 0 && (
        <ul class="mt-12 divide-y divide-rule border-t border-rule">
          {latest.map((lesson) => (
            <li>
              <a href={`/lessons/${lesson.data.slug}`} class="block py-5">
                <span class="bg-tag px-2 py-0.5 text-xs">{lesson.data.category}</span>
                <h2 class="mt-3 text-base font-bold">{lesson.data.title}</h2>
                <p class="mt-1 text-sm text-muted">{lesson.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-8">
      <a href="/lessons" class="border-b border-alert pb-0.5 text-sm text-alert">
        All lessons
      </a>
    </p>
  </div>
</BaseLayout>
