---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const lessons = await getCollection(
  'lessons',
  ({ data }) => import.meta.env.DEV || !data.draft,
);

lessons.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const latest = lessons.slice(0, 3);
---

<BaseLayout
  title="Japanese, one thing at a time"
  description="Short Japanese lessons with a Singlish and Chinese-speaker angle.">
  <div class="wrap">
    <h1 class="display-xl mt-10">Japanese,<br />one thing<br />at a time</h1>

    <p class="measure mt-10 text-lg leading-relaxed text-muted">
      Short lessons, written for anyone learning Japanese — with the comparisons
      a Singlish or Chinese speaker would actually notice.
    </p>

    {
      latest.length > 0 && (
        <ul class="mt-20 border-t border-rule">
          {latest.map((lesson, i) => (
            <li class="border-b border-rule">
              <a
                href={`/lessons/${lesson.data.slug}`}
                class="group grid grid-cols-1 gap-3 py-7 md:grid-cols-[4rem_1fr_18rem] md:items-baseline md:gap-8">
                <span class="text-xs text-muted tabular-nums">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h2 class="display-lg group-hover:text-alert">{lesson.data.title}</h2>
                <span class="flex flex-col gap-3">
                  <span class="bg-tag self-start px-2 py-0.5 text-xs">
                    {lesson.data.category}
                  </span>
                  <span class="text-sm leading-relaxed text-muted">{lesson.data.summary}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-10">
      <a href="/lessons" class="border-b border-alert pb-0.5 text-sm text-alert">All lessons</a>
    </p>
  </div>
</BaseLayout>
