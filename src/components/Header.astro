---
const path = Astro.url.pathname;

const links = [
  { href: '/lessons', label: 'lessons' },
  { href: '/practice', label: 'practice' },
  { href: '/research', label: 'analysis' },
  { href: '/search', label: 'search' },
];
---

<header class="wrap flex items-baseline justify-between border-b border-rule py-4">
  <a href="/" class="brand text-sm font-bold tracking-tight">madojapan</a>
  <nav class="flex gap-5">
    {
      links.map(({ href, label }) => {
        const current = path.startsWith(href);
        return (
          <a
            href={href}
            class:list={['text-xs tracking-wide', current ? 'text-ink' : 'text-muted']}
            aria-current={current ? 'page' : undefined}>
            {label}
          </a>
        );
      })
    }
  </nav>
</header>
